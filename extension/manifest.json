{
  "manifest_version": 2,
  "name": "MediaDownloader Sniffer",
  "version": "1.4.0",
  "description": "浮层下载 + 嗅探 + 右键发送 + 下载拦截 → 本机 MediaDownloader",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "tabs",
    "contextMenus",
    "downloads",
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "发送媒体到下载器",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mediadownloader-sniffer@local",
      "strict_min_version": "78.0"
    }
  }
}